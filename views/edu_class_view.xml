<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Form view -->
  <record id="edu_class_form_view" model="ir.ui.view">
    <field name="name">edu.class.form.view</field>
    <field name="model">edu.class</field>
    <field name="arch" type="xml">
      <form string="Clase">
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name" readonly="1" />
            </h1>
          </div>
          <group>
	    <group>
              <field name="course_instance_id" invisible="1"/>
	      <field name="teacher_id"/>
	      <field name="date"/>
	      <field name="is_teacher_present"
		     widget="boolean_toggle"/>
	    </group>
	    <group>
	     <field name="commission_id"/>
	     <field name="observation"/>
	    </group> 
          </group>
          <notebook>
            <page string="Asistencias">
              <field name="assistance_ids">
                <list create="0"
		      delete="0"
		      editable="top">
                  <field name="student_id"/>
                  <field name="assistance"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
