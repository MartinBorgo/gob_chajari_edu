<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Form view -->
    <record id="edu_student_form_view" model="ir.ui.view">
        <field name="name">edu.student.form</field>
        <field name="model">edu.student</field>
        <field name="arch" type="xml">
            <form string="Estudiante">
                <sheet>
                    <field
                        name="photo"
                        widget="image"
                        class="oe_avatar"
                        options="{'preview_image': 'photo'}"
                    />

                    <div class="oe_title">
                        <label for="name" string="Nombre completo" />
                        <h1>
                            <field name="name" placeholder="Ej. Juan Pérez" />
                        </h1>
                    </div>
                    <group id="root_group">
                        <group id="personal_data_group">
                            <field name="dni" />
                            <field name="phone" />
                            <field name="birthday" />
                        </group>
                        <group id="extra_data_group">
                            <field name="living_place" />
                            <field name="max_educative_level" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Historial">
                            <field name="student_history_ids" readonly="1">
                                <list>
                                    <field name="course_instance_id" />
                                    <field name="student_state"
					 widget="badge"
					 decoration-success="student_state == 'pass'"
                                         decoration-danger="student_state == 'not_pass'"
                                         decoration-info="student_state == 'attending'"
                                         decoration-warning="student_state == 'give_up'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view -->
    <record id="edu_student_list_view" model="ir.ui.view">
        <field name="name">edu.student.list</field>
        <field name="model">edu.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="dni" />
                <field name="phone" />
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="edu_student_action" model="ir.actions.act_window">
        <field name="name">Estudiantes</field>
        <field name="res_model">edu.student</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No existen estudiantes cargados.
            </p>
        </field>
    </record>
</odoo>
